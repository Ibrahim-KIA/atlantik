APP_ENV=development
# scripts/dev-up.sh generates unique local secrets automatically.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
APP_ENCRYPTION_KEY=
BILLING_WEBHOOK_SECRET=
BILLING_MODE=simulation
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=Atlantik <noreply@example.test>
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Optional exact trusted proxy CIDR; never blindly trust all incoming forwarded headers.
TRUST_PROXY=
# For host development only; use the restricted role. Compose derives its internal URLs.
DATABASE_URL=
REDIS_URL=redis://localhost:6379
